{
  "name": "vscode-gungnir",
  "displayName": "Gungnir",
  "description": "VS Code language tools and developer commands for the Gungnir framework.",
  "version": "0.1.0",
  "publisher": "gungnir",
  "license": "MIT",
  "private": false,
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "gungnir",
    "gnr",
    "cpp",
    "framework"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:gungnir.showStatus",
    "onLanguage:gungnir",
    "onCommand:gungnir.checkInstallation",
    "onCommand:gungnir.selectExecutable",
    "onCommand:gungnir.refreshToolchain"
  ],
  "contributes": {
    "commands": [
      {
        "command": "gungnir.showStatus",
        "title": "Gungnir: Show Extension Status",
        "category": "Gungnir"
      },
      {
        "command": "gungnir.checkInstallation",
        "title": "Gungnir: Check SDK Installation",
        "category": "Gungnir"
      },
      {
        "command": "gungnir.selectExecutable",
        "title": "Gungnir: Select CLI Executable",
        "category": "Gungnir"
      },
      {
        "command": "gungnir.refreshToolchain",
        "title": "Gungnir: Refresh Toolchain Detection",
        "category": "Gungnir"
      }
    ],
    "languages": [
      {
        "id": "gungnir",
        "aliases": [
          "Gungnir",
          "gungnir"
        ],
        "extensions": [
          ".gnr"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./resources/icons/gungnir-light.svg",
          "dark": "./resources/icons/gungnir-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "gungnir",
        "scopeName": "source.gungnir",
        "path": "./syntaxes/gungnir.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gungnir",
        "path": "./snippets/gungnir.code-snippets"
      }
    ],
    "configuration": {
      "title": "Gungnir",
      "properties": {
        "gungnir.executablePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Absolute path to the installed `gungnir` CLI executable. When set, this takes precedence over SDK root and `PATH`. Blank means discover automatically."
        },
        "gungnir.sdkRoot": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Absolute SDK root directory containing `bin/gungnir` (or `bin/gungnir.exe`). Overrides automatic detection when no explicit executable path is provided."
        },
        "gungnir.toolchain.autoDetect": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Check the local Gungnir CLI and SDK after activating the extension in a trusted workspace. No code is executed in restricted/untrusted workspaces."
        },
        "gungnir.toolchain.timeoutMs": {
          "type": "integer",
          "default": 3000,
          "minimum": 500,
          "maximum": 10000,
          "scope": "machine-overridable",
          "markdownDescription": "Maximum milliseconds for each CLI version probe. Applies only when the workspace is trusted."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/esbuild.mjs",
    "watch": "node scripts/esbuild.mjs --watch",
    "build": "npm run typecheck && npm run bundle",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:integration": "node dist-test/runTest.js",
    "package": "npm run build && vsce package --no-dependencies -o vscode-gungnir.vsix",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "mocha": "^11.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justinangeloperez327/vscode-gungnir.git"
  },
  "bugs": {
    "url": "https://github.com/justinangeloperez327/vscode-gungnir/issues"
  }
}
