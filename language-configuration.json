{
  "$schema": "https://raw.githubusercontent.com/microsoft/vscode/main/extensions/json/schemas/language-configuration.schema.json",
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^(?!\\s*(?://|\\*|#)).*(?:\\{|\\[|\\()\\s*(?://.*)?$",
    "decreaseIndentPattern": "^\\s*[}\\]\\)]"
  },
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*(?://\\s*#?\\s*|#\\s*)region\\b",
      "end": "^\\s*(?://\\s*#?\\s*|#\\s*)endregion\\b"
    }
  },
  "wordPattern": "(-?\\d+(?:\\.\\d+)?)|([A-Za-z_][A-Za-z0-9_]*)",
  "onEnterRules": [
    {
      "beforeText": "^\\s*/\\*\\*(?!/).*$",
      "afterText": "^\\s*\\*/$",
      "action": {
        "indent": "indentOutdent",
        "appendText": " * "
      }
    },
    {
      "beforeText": "^\\s*/\\*\\*(?!/).*$",
      "action": {
        "indent": "none",
        "appendText": " * "
      }
    },
    {
      "beforeText": "^\\s*\\*(?!/).*$",
      "action": {
        "indent": "none",
        "appendText": "* "
      }
    }
  ]
}
